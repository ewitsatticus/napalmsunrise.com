    letter-spacing: 0.1em;
    color: var(--red, #E8260A);
    min-height: 1.4em;
    margin-bottom: 4px;
  }
  .gt-note {
    font-family: var(--font-ui, 'DM Mono', monospace);
    font-size: 9px;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  /* ── RIGHT COLUMN ── */
  .gt-viewport-wrap { position: relative; }

  /* Status bar */
  .gt-status-bar {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .gt-status-label, .gt-status-pct {
    font-family: var(--font-ui, 'DM Mono', monospace);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }
  .gt-status-pct { color: rgba(255,255,255,0.6); }

  /* Health bar */
  .gt-bar-track {
    width: 100%;
    height: 6px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
