<div class="gorthog-tama" id="gorthog-tama">
  <div class="gt-inner">

    <!-- LEFT: copy + email -->
    <div class="gt-copy">
      <div class="gt-eyebrow">/ Gorthog Demands Tribute</div>
      <h2 class="gt-title" id="gt-title">FEED<br>THE ORC</h2>
      <p class="gt-body" id="gt-body">Gorthog has not eaten in some time. He sustains himself on email addresses. If you do not feed him, he will die. This is not a metaphor.</p>

      <div class="gt-form-wrap" id="gt-form-wrap">
        <label class="gt-label">Your email (his food)</label>
        <div class="gt-input-row">
          <input class="gt-input" type="email" id="gt-email" placeholder="your@email.com" autocomplete="email">
          <button class="btn btn-red gt-feed-btn" id="gt-feed-btn">Feed Him</button>
        </div>
        <p class="gt-error" id="gt-error"></p>
        <p class="gt-note">He will remember this kindness. Or he will die. One of the two.</p>
      </div>

      <div class="gt-restart-wrap" id="gt-restart-wrap" style="display:none;">
        <button class="btn btn-outline gt-restart-btn" id="gt-restart-btn">Resurrect Gorthog</button>
      </div>
    </div>

    <!-- RIGHT: the orc viewport -->
    <div class="gt-viewport-wrap">
      <div class="gt-status-bar">
        <span class="gt-status-label">LIFE FORCE</span>
        <span class="gt-status-pct" id="gt-pct">100%</span>
      </div>
      <div class="gt-bar-track">
        <div class="gt-bar-fill" id="gt-bar"></div>
      </div>

      <div class="gt-viewport" id="gt-viewport">
        <!-- ORC PORTRAIT -->
        <div class="gt-orc" id="gt-orc">
          <div class="gt-orc-ear gt-orc-ear--l"></div>
          <div class="gt-orc-ear gt-orc-ear--r"></div>
          <div class="gt-orc-head">
            <div class="gt-orc-brow gt-orc-brow--l"></div>
            <div class="gt-orc-brow gt-orc-brow--r"></div>
            <div class="gt-orc-eye gt-orc-eye--l"><div class="gt-orc-pupil"></div></div>
            <div class="gt-orc-eye gt-orc-eye--r"><div class="gt-orc-pupil"></div></div>
            <div class="gt-orc-tusk gt-orc-tusk--l"></div>
            <div class="gt-orc-tusk gt-orc-tusk--r"></div>
            <div class="gt-orc-mouth"></div>
          </div>
          <div class="gt-orc-body"></div>
        </div>
        <div class="gt-blood" id="gt-blood"></div>
      </div>

      <div class="gt-speech" id="gt-speech">
        <span class="gt-speech-text" id="gt-speech-text"></span><span class="gt-cursor" id="gt-cursor">_</span>
      </div>

      <div class="gt-mood" id="gt-mood">GORTHOG AWAITS</div>
    </div>

  </div>
</div>

<style>
  /* ── GORTHOG TAMAGOTCHI ── */
  .gorthog-tama {
    background: var(--black, #0D0D0D);
    color: var(--bg, #F3EDE0);
    padding: 64px 28px;
    border-bottom: 4px solid var(--red, #E8260A);
    overflow: hidden;
  }
  .gt-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 72px;
    align-items: start;
  }

  /* ── LEFT COLUMN ── */
  .gt-eyebrow {
    font-family: var(--font-ui, 'DM Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red, #E8260A);
    margin-bottom: 16px;
  }
  .gt-title {
    font-family: var(--font-display, 'Bebas Neue', sans-serif);
    font-size: 84px;
    line-height: 0.88;
    letter-spacing: 0.02em;
    margin-bottom: 24px;
    transition: color 0.3s;
  }
  .gt-title.danger { color: var(--red, #E8260A); }
  .gt-body {
    font-family: var(--font-body, 'Courier Prime', monospace);
    font-size: 15px;
    line-height: 1.75;
    color: rgba(243,237,224,0.6);
    margin-bottom: 28px;
    max-width: 560px;
  }

  /* Form */
  .gt-label {
    font-family: var(--font-ui, 'DM Mono', monospace);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    display: block;
    margin-bottom: 8px;
  }
  .gt-input-row {
    display: flex;
    gap: 10px;
    margin-bottom: 8px;
  }
  .gt-input {
    flex: 1;
    background: rgba(255,255,255,0.04);
    border: 2px solid rgba(255,255,255,0.12);
    color: var(--bg, #F3EDE0);
    font-family: var(--font-body, 'Courier Prime', monospace);
    font-size: 14px;
    font-style: italic;
    padding: 10px 14px;
    outline: none;
    transition: border-color 0.15s;
  }
  .gt-input:focus { border-color: var(--red, #E8260A); }
  .gt-input::placeholder { color: rgba(255,255,255,0.2); }
  .gt-input:disabled { opacity: 0.3; cursor: not-allowed; }
  .gt-feed-btn { white-space: nowrap; flex-shrink: 0; }
  .gt-feed-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .gt-error {
    font-family: var(--font-ui, 'DM Mono', monospace);
