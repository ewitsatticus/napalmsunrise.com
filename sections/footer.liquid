<footer style="background:var(--black);color:var(--bg);border-top:var(--border);">
  <div style="max-width:1440px;margin:0 auto;padding:56px 28px 40px;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:56px;">
    <div>
      <div style="font-family:var(--font-display);font-size:28px;letter-spacing:0.08em;margin-bottom:14px;">
        NAPALM<span style="color:var(--red);">SUNRISE</span>
      </div>
      <p style="font-size:13px;color:rgba(243,237,224,0.38);line-height:1.6;">
        {{ section.settings.description }}
      </p>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h5 style="font-family:var(--font-display);font-size:16px;letter-spacing:0.1em;margin-bottom:14px;">{{ block.settings.heading }}</h5>
          {%- endif -%}
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}" style="font-family:var(--font-ui);font-size:10px;letter-spacing:0.1em;color:rgba(243,237,224,0.35);text-decoration:none;display:block;line-height:2.2;transition:color 0.1s;"
               onmouseover="this.style.color='#E8260A'"
               onmouseout="this.style.color='rgba(243,237,224,0.35)'"
            >{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div style="max-width:1440px;margin:0 auto;padding:20px 28px;border-top:1px solid rgba(255,255,255,0.08);display:flex;justify-content:space-between;align-items:center;">
    <p style="font-family:var(--font-ui);font-size:9px;letter-spacing:0.1em;color:rgba(255,255,255,0.18);text-transform:uppercase;">
      &copy; {{ 'now' | date: '%Y' }} Napalm Sunrise. All experiments conducted without supervision.
    </p>
    <p style="font-family:var(--font-ui);font-size:9px;letter-spacing:0.1em;color:rgba(255,255,255,0.18);text-transform:uppercase;">
      Built on Shopify · Automated via Claude API · Hosted in the void
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "description",
      "label": "Footer tagline",
      "default": "A public lab. Questionable conclusions. Run by someone who documents everything and regrets nothing."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
