<header style="background:var(--black);border-bottom:4px solid var(--red);position:sticky;top:0;z-index:200;">
  <div class="header-inner" style="max-width:1440px;margin:0 auto;display:grid;grid-template-columns:auto 1fr auto;align-items:stretch;padding:0 28px;">
    <a href="/" class="logo" style="font-family:var(--font-display);font-size:26px;letter-spacing:0.1em;color:var(--bg);padding:14px 0;text-decoration:none;user-select:none;display:flex;align-items:center;">
      NAPALM<span style="color:var(--red);">SUNRISE</span>
    </a>

    <nav style="display:flex;align-items:stretch;justify-content:center;gap:0;">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"
           style="font-family:var(--font-ui);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(243,237,224,0.55);text-decoration:none;padding:0 16px;display:flex;align-items:center;border-left:1px solid rgba(255,255,255,0.08);transition:background 0.12s,color 0.12s;white-space:nowrap;"
           {% if link.active %}class="active" {% endif %}
           onmouseover="this.style.background='rgba(255,255,255,0.06)';this.style.color='#F3EDE0'"
           onmouseout="if(!this.classList.contains('active')){this.style.background='';this.style.color='rgba(243,237,224,0.55)'}"
        >
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    <div style="display:flex;align-items:center;gap:12px;padding:10px 0;">
      <a href="/cart" style="font-family:var(--font-ui);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(243,237,224,0.55);text-decoration:none;padding:7px 14px;border:1px solid rgba(255,255,255,0.15);transition:all 0.12s;"
         onmouseover="this.style.background='rgba(255,255,255,0.06)';this.style.color='#F3EDE0'"
         onmouseout="this.style.background='';this.style.color='rgba(243,237,224,0.55)'"
      >
        Cart ({{ cart.item_count }})
      </a>
    </div>
  </div>
</header>

<!-- TICKER -->
{%- if section.settings.show_ticker -%}
<div style="background:#0D0D0D;border-bottom:2px solid rgba(232,38,10,0.4);padding:7px 0;overflow:hidden;">
  <div style="max-width:1440px;margin:0 auto;padding:0 28px;display:flex;gap:56px;align-items:center;animation:ticker-scroll 30s linear infinite;">
    {%- for block in section.blocks -%}
      {%- if block.type == 'ticker_item' -%}
        <div class="tick" style="display:flex;align-items:center;gap:10px;font-family:var(--font-ui);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(243,237,224,0.38);white-space:nowrap;">
          <div style="width:5px;height:5px;border-radius:50;flex-shrink:0;
            {%- if block.settings.status == 'active' -%}background:var(--red);animation:blink 2.4s ease-in-out infinite;
            {%- elsif block.settings.status == 'done' -%}background:var(--muted);
            {%- elsif block.settings.status == 'queued' -%}background:var(--acid);
            {%- endif -%}
            border-radius:50%;"></div>
          {{ block.settings.text }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

<style>
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }
  @keyframes ticker-scroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
  nav a.active { background: var(--red) !important; color: var(--bg) !important; }
</style>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show ticker bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Ticker text",
          "default": "Active: New experiment running"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status indicator",
          "options": [
            { "value": "active", "label": "Active (red pulse)" },
            { "value": "done", "label": "Done (muted)" },
            { "value": "queued", "label": "Queued (acid green)" }
          ],
          "default": "active"
        }
      ]
    }
  ]
}
{% endschema %}
