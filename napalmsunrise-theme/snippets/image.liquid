{%- comment -%}
  Responsive image with srcset and lazy loading.
  Usage: {% render 'image', image: product.featured_image, alt: product.title, sizes: '(max-width: 768px) 100vw, 50vw' %}
{%- endcomment -%}

{%- if image -%}
  <img
    src="{{ image | image_url: width: 800 }}"
    srcset="
      {{ image | image_url: width: 400 }} 400w,
      {{ image | image_url: width: 600 }} 600w,
      {{ image | image_url: width: 800 }} 800w,
      {{ image | image_url: width: 1200 }} 1200w
    "
    sizes="{{ sizes | default: '(max-width: 768px) 100vw, 33vw' }}"
    alt="{{ alt | escape }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    loading="{{ loading | default: 'lazy' }}"
    class="{{ class }}"
  >
{%- else -%}
  <div class="placeholder-image" style="aspect-ratio: 1; background: var(--color-border);"></div>
{%- endif -%}
