{{ 'component-product.css' | asset_url | stylesheet_tag }}

<section class="product-page section-padding" data-product>
  <div class="page-width">
    <div class="product-page__grid">
      {%- comment -%} Product Images {%- endcomment -%}
      <div class="product-page__media card">
        <div class="product-page__main-image">
          {% render 'image',
            image: product.selected_or_first_available_variant.featured_image | default: product.featured_image,
            alt: product.title,
            sizes: '(max-width: 768px) 100vw, 50vw',
            loading: 'eager',
            class: 'product-page__img'
          %}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-page__thumbs">
            {%- for image in product.images -%}
              <button
                class="product-page__thumb{% if forloop.first %} is-active{% endif %}"
                data-thumb
                data-image-url="{{ image | image_url: width: 1200 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 100, height: 100, crop: 'center' }}"
                  alt="{{ product.title | escape }} - image {{ forloop.index }}"
                  width="100"
                  height="100"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="product-page__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'title' -%}
              <h1 class="product-page__title" {{ block.shopify_attributes }}>
                {{ product.title }}
              </h1>

            {%- when 'price' -%}
              <div class="product-page__price" {{ block.shopify_attributes }} data-product-price>
                {% render 'price', product: product %}
              </div>

            {%- when 'variant_picker' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'product-variant-picker', product: product %}
              </div>

            {%- when 'quantity_selector' -%}
              <div {{ block.shopify_attributes }}>
                <label class="product-page__label">{{ 'products.quantity' | t }}</label>
                {% render 'quantity-input' %}
              </div>

            {%- when 'buy_button' -%}
              <div {{ block.shopify_attributes }}>
                <form action="/cart/add" method="post" data-product-form>
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
                  <input type="hidden" name="quantity" value="1" data-form-qty>

                  <button
                    type="submit"
                    class="btn btn--accent btn--full"
                    {% unless product.available %}disabled{% endunless %}
                  >
                    {%- if product.available -%}
                      {{ 'products.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.sold_out' | t }}
                    {%- endif -%}
                  </button>
                </form>
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product-page__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'share' -%}
              <div class="product-page__share" {{ block.shopify_attributes }}>
                <button class="btn btn--outline" onclick="navigator.share ? navigator.share({title: '{{ product.title | escape }}', url: window.location.href}) : void(0)">
                  {% render 'icon', name: 'share' %}
                  {{ 'products.share' | t }}
                </button>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product page",
  "tag": "section",
  "class": "section-product",
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "buy_button",
      "name": "Buy button",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "share",
      "name": "Share button",
      "limit": 1
    }
  ]
}
{% endschema %}
