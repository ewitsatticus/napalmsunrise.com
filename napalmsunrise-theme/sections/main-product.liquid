<div class="wrap">
  <div class="product-layout">
    <div class="product-gallery">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800">
      {%- endif -%}
      {%- unless product.available -%}
        <div class="sold-stamp" style="position:absolute;">SOLD OUT</div>
      {%- endunless -%}
    </div>

    <div class="product-details">
      <div class="prod-type" style="margin-bottom:12px;">{{ product.type }}</div>
      <h1>{{ product.title | upcase }}</h1>

      <div class="product-price-main">
        {%- if product.available -%}
          {{ product.price | money }}
        {%- else -%}
          <span style="text-decoration:line-through;color:var(--gray);">{{ product.price | money }}</span>
          <span class="oos-label" style="margin-left:12px;">Out of Stock</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="product-description">{{ product.description }}</div>
      {%- endif -%}

      {%- if product.has_only_default_variant == false -%}
        {%- for option in product.options_with_values -%}
          <div class="fg">
            <label>{{ option.name }}</label>
            <select name="id" style="font-style:normal;">
              {%- for value in option.values -%}
                <option value="{{ value }}">{{ value }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endfor -%}
      {%- endif -%}

      <form action="/cart/add" method="post">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        {%- if product.available -%}
          <button type="submit" class="btn btn-fill" style="width:100%;padding:16px;">Add to Cart</button>
        {%- else -%}
          <button type="button" class="btn" style="width:100%;padding:16px;opacity:0.5;cursor:not-allowed;" disabled>Sold Out</button>
        {%- endif -%}
      </form>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Page",
  "settings": [],
  "blocks": []
}
{% endschema %}
