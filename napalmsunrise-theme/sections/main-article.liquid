<div class="wrap">
  <div class="page-hdr">
    {%- if article.tags.size > 0 -%}
      <div class="eyebrow">{{ article.tags | join: ' · ' }}</div>
    {%- endif -%}
    <h1>{{ article.title | upcase }}</h1>
    <p class="sub">{{ article.published_at | date: '%B %d, %Y' }} · by {{ article.author }} · {{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</p>
  </div>

  <div style="display:grid;grid-template-columns:1fr 360px;gap:64px;">
    <div>
      {%- if article.image -%}
        <div style="margin-bottom:40px;border:var(--border);overflow:hidden;">
          <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" loading="eager" width="1200">
        </div>
      {%- endif -%}

      <div class="article-content" style="font-size:17px;line-height:1.85;max-width:680px;">
        {{ article.content }}
      </div>

      <div class="spacer-48"></div>

      {%- if blog.articles.size > 1 -%}
        <div class="border-top pt-48">
          <h2 style="font-family:var(--font-display);font-size:36px;letter-spacing:0.05em;margin-bottom:24px;">MORE LAB NOTES</h2>
          <div class="blog-grid" style="grid-template-columns:repeat(2,1fr);">
            {%- for related in blog.articles limit: 2 -%}
              {%- unless related.id == article.id -%}
                <a href="{{ related.url }}" class="blog-card">
                  <h3 class="bc-title">{{ related.title }}</h3>
                  <div class="bc-meta">{{ related.published_at | date: '%b %d, %Y' }}</div>
                </a>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div>
      <div class="info-box">
        <h4>About the Author</h4>
        <p>{{ article.author }}</p>
      </div>
      <div class="info-box">
        <h4>Tags</h4>
        <p>
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" style="text-decoration:none;color:var(--red);">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
          {%- endfor -%}
        </p>
      </div>
    </div>
  </div>

  <div class="spacer-48"></div>
</div>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
