{{ 'section-hero-cd.css' | asset_url | stylesheet_tag }}

<section class="hero-cd" data-hero-cd>
  <div class="hero-cd__canvas-wrap" id="cd-canvas-mount">
    <noscript>
      <div class="hero-cd__fallback">
        {%- if section.settings.cd_art -%}
          <img
            src="{{ section.settings.cd_art | image_url: width: 600 }}"
            alt="{{ section.settings.heading | escape }}"
            width="600"
            height="600"
            class="hero-cd__fallback-img"
          >
        {%- endif -%}
      </div>
    </noscript>
  </div>

  <div class="hero-cd__content card card--glass">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero-cd__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero-cd__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_url }}" class="btn btn--primary hero-cd__cta">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>

  <script type="application/json" id="cd-config">
    {
      "cdArt": {{ section.settings.cd_art | image_url: width: 1024 | json }},
      "enableAudio": {{ section.settings.enable_audio | json }},
      "audioVolume": {{ section.settings.audio_volume | json }},
      "accentColor": {{ settings.color_accent | json }}
    }
  </script>
</section>

<script type="module">
  import { initCDScene } from '{{ "cd-scene.js" | asset_url }}';
  import { CDChordEngine } from '{{ "cd-audio.js" | asset_url }}';
  import { CDController } from '{{ "cd-controller.js" | asset_url }}';

  const mount = document.getElementById('cd-canvas-mount');
  const configEl = document.getElementById('cd-config');
  if (mount && configEl) {
    const config = JSON.parse(configEl.textContent);
    const scene = initCDScene(mount, config);
    const audio = new CDChordEngine(config);
    new CDController(mount, scene, audio, config);
  }
</script>

{% schema %}
{
  "name": "Hero CD",
  "tag": "section",
  "class": "section-hero-cd",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NAPALM SUNRISE"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Virtual interhuman connection."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Enter"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "cd_art",
      "label": "CD artwork"
    },
    {
      "type": "checkbox",
      "id": "enable_audio",
      "label": "Enable audio interaction",
      "default": true
    },
    {
      "type": "range",
      "id": "audio_volume",
      "label": "Audio volume",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Hero CD"
    }
  ]
}
{% endschema %}
